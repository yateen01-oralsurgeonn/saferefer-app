# Copy this file to .env.local and fill in the values from the Firebase console
# (Project settings > Your apps > SDK setup and configuration).
# .env.local is gitignored. Never commit it.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# reCAPTCHA Enterprise site key for App Check on the hosted site (T13).
VITE_RECAPTCHA_ENTERPRISE_SITE_KEY=

# App Check debug token, used on localhost only (npm run dev).
# Make one with: node -e "console.log(crypto.randomUUID())"
# then register it in Firebase console > App Check > Apps > Manage debug tokens.
VITE_APPCHECK_DEBUG_TOKEN=
